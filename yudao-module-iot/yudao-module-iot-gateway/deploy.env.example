# IoT 网关 生产环境变量模板
# 用法：cp deploy.env.example deploy.env，填写真实值后由 deploy.sh 通过 --env-file 注入。
# ⚠️ deploy.env 含明文密码，务必加入 .gitignore，切勿提交！

# ---- Redis（无密码则留空）----
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_DATABASE=0
REDIS_PASSWORD=

# ---- RocketMQ ----
ROCKETMQ_NAME_SERVER=127.0.0.1:9876

# ---- 主程序 API 地址 ----
IOT_RPC_URL=http://127.0.0.1:48080

# ---- 网关 Token 密钥（必填，至少 32 位）----
IOT_GATEWAY_TOKEN_SECRET=改成你的至少32位随机密钥xxxxxxxxxxxxxxxx

# ---- EMQX MQTT Broker 账号（必填 EMQX_PASSWORD，原硬编码密码已移除）----
EMQX_HOST=127.0.0.1
EMQX_PORT=1883
EMQX_USERNAME=admin
EMQX_PASSWORD=改成你的EMQX桥接账号密码
EMQX_SSL=false

# ---- App 客户端产品 Key（可选，默认沿用示例值）----
# IOT_APP_PRODUCT_KEY=ke5EYZurCB3FwFXp
