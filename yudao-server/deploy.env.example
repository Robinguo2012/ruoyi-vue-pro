# yudao-server 生产环境变量模板
# 用法：cp deploy.env.example deploy.env，填写真实值后由 deploy.sh 通过 --env-file 注入。
# ⚠️ deploy.env 含明文密码，务必加入 .gitignore，切勿提交！
#
# 由于 deploy.sh 使用 --network=host，各 *_HOST 默认 127.0.0.1（宿主机）即可，通常无需改。

# ---- MySQL（必填 MYSQL_PASSWORD）----
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_DATABASE=ruoyi-vue-pro
MYSQL_USERNAME=root
MYSQL_PASSWORD=改成你的强密码

# ---- Redis（无密码则留空 REDIS_PASSWORD=）----
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_DATABASE=0
REDIS_PASSWORD=

# ---- TDengine（仅 IoT 需要）----
TDENGINE_HOST=127.0.0.1
TDENGINE_PORT=6041
TDENGINE_DATABASE=ruoyi_vue_pro
TDENGINE_USERNAME=root
TDENGINE_PASSWORD=taosdata

# ---- RocketMQ ----
ROCKETMQ_NAME_SERVER=127.0.0.1:9876

# ---- 监控台口令（必填）----
DRUID_USERNAME=admin
DRUID_PASSWORD=改成你的强密码
SPRING_BOOT_ADMIN_USERNAME=admin
SPRING_BOOT_ADMIN_PASSWORD=改成你的强密码

# ---- 其他（可选）----
# 公网域名，用于放行 Spring Boot Admin 的 iframe 嵌入，例如 your-domain.com
WEB_DOMAIN=
